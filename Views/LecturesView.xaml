<UserControl x:Class="TestingSystem.Views.LecturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TestingSystem.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{loc:T Tab_Lectures}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{loc:T Lect_New}" Command="{Binding NewCommand}" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="{loc:T Btn_Edit}" Command="{Binding EditCommand}" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="{loc:T Btn_Delete}" Command="{Binding DeleteCommand}" Padding="12,5" />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{loc:T Lbl_Search}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="4" Margin="0,0,14,0" />

            <TextBlock Text="{loc:T Lbl_Category}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}"
                      DisplayMemberPath="Text" Width="170" Padding="4" Margin="0,0,14,0" />

            <TextBlock Text="{loc:T Filter_Status}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                      DisplayMemberPath="Text" Width="140" Padding="4" Margin="0,0,14,0" />

            <Button Content="{loc:T Btn_ResetFilters}" Command="{Binding ResetFiltersCommand}" Padding="10,4" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyMessage}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Meta}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
